{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-console/schemas/codex-result-2.0.json",
  "title": "Video Console Codex Result 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "action", "status", "summary", "questions", "artifacts", "asset_outputs", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "format": "uuid"},
    "action": {"enum": ["topic.brainstorm", "topic.commit", "topic.deepen", "remix.standard", "remix.enhanced", "remix.from_topic_card", "remix.review", "montage.plan", "montage.execute"]},
    "status": {"enum": ["completed", "awaiting_input", "failed"]},
    "summary": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "additionalProperties": false, "required": ["text", "options"], "properties": {"text": {"type": "string", "minLength": 1}, "options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}}
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "kind": {"enum": ["file", "directory"]},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["narration_present", "bgm_present", "sfx_present", "transitions_present"],
            "properties": {
              "narration_present": {"const": true},
              "bgm_present": {"const": true},
              "sfx_present": {"const": true},
              "transitions_present": {"const": true}
            }
          }
        },
        "oneOf": [{"required": ["description"], "not": {"required": ["kind"]}}, {"required": ["kind"], "not": {"required": ["description"]}}],
        "allOf": [{"if": {"required": ["metadata"]}, "then": {"required": ["kind"], "properties": {"type": {"const": "plaintext_workspace"}, "kind": {"const": "directory"}}}}]
      }
    },
    "asset_outputs": {
      "type": "array",
      "items": {"oneOf": [{
        "type": "object", "additionalProperties": false,
        "required": ["type", "path", "storage_kind", "filename", "mime", "size", "sha256"], "properties": {
          "type": {"enum": ["source_script", "topic_card", "continuous_script", "narration", "subtitle_srt", "account_background", "mix_draft", "final_video"]},
          "path": {"type": "string", "minLength": 1},
          "storage_kind": {"enum": ["file", "directory"]},
          "filename": {"type": "string", "minLength": 1},
          "mime": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }, "allOf": [
          {"if": {"properties": {"storage_kind": {"const": "file"}}}, "then": {"required": ["sha256"]}},
          {"if": {"properties": {"storage_kind": {"const": "directory"}}}, "then": {"properties": {"mime": {"const": "inode/directory"}, "size": {"const": 0}}}}
        ]}, {"type": "object", "additionalProperties": false, "required": ["type", "kind", "path", "metadata"], "properties": {
          "type": {"enum": ["source_script", "topic_card", "continuous_script", "narration", "subtitle_srt", "account_background", "mix_draft", "final_video"]},
          "kind": {"enum": ["file", "directory"]}, "path": {"type": "string", "minLength": 1},
          "metadata": {"type": "object", "additionalProperties": false, "properties": {
            "registered_path": {"type": ["string", "null"]},
            "narration_present": {"type": "boolean"}, "bgm_present": {"type": "boolean"},
            "sfx_present": {"type": "boolean"}, "transitions_present": {"type": "boolean"}
          }}
        }}]}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "awaiting_input"}}}, "then": {"properties": {"questions": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"enum": ["awaiting_input", "failed"]}}}, "then": {"properties": {"asset_outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"action": {"const": "topic.brainstorm"}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"const": "topic_candidates"}}}}, "asset_outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"action": {"enum": ["topic.commit", "topic.deepen"]}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"const": "topic_card"}}, "required": ["relative_path", "sha256"]}}, "asset_outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"action": {"enum": ["remix.standard", "remix.enhanced", "remix.from_topic_card"]}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"enum": ["viral_analysis", "structure_design", "publishing_package", "self_check"]}}}}, "asset_outputs": {"items": {"properties": {"type": {"const": "continuous_script"}}}}}}},
    {"if": {"properties": {"action": {"const": "remix.review"}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"enum": ["viral_analysis", "structure_design", "self_check"]}}}}, "asset_outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"action": {"const": "montage.plan"}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"enum": ["production_plan", "production_plan_readable", "production_plan_validation", "draft_validation", "selected_media_summary", "registration_result", "qc_report", "events", "stderr_log", "plaintext_workspace"]}}}}, "asset_outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"action": {"const": "montage.execute"}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"type": {"enum": ["production_plan", "production_plan_readable", "production_plan_validation", "draft_validation", "selected_media_summary", "qc_report", "events", "stderr_log", "plaintext_workspace"]}}}}, "asset_outputs": {"maxItems": 0}}}}
  ]
}
