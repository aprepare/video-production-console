{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-production-console.local/schemas/settings.schema.json",
  "title": "Video production console settings",
  "oneOf": [
    { "$ref": "#/$defs/settingsView" },
    { "$ref": "#/$defs/settingsUpdate" }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "maxLength": 32767,
      "pattern": "^(?:[A-Za-z]:\\\\|/).+"
    },
    "optionalAbsolutePath": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/absolutePath" }
      ]
    },
    "publicSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listen_addr",
        "data_root",
        "max_codex_concurrency",
        "codex_default_model",
        "codex_default_reasoning_effort",
        "baokuan_base_url",
        "baokuan_mcp_executable",
        "obsidian_vault",
        "topic_cards_dir",
        "grok_base_url",
        "grok_model",
        "codex_binary_path",
        "media_index_path",
        "media_root",
        "jianying_root",
        "machine_profile_path",
        "app_server_enabled",
        "codex_workspace_roots",
        "codex_task_project_root",
        "volc_speech_speaker_id",
        "volc_speech_resource_id"
      ],
      "properties": {
        "listen_addr": {
          "type": "string",
          "maxLength": 263,
          "pattern": "^(?:localhost|(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|\\[[0-9A-Fa-f:]+\\]):[0-9]{1,5}$"
        },
        "data_root": { "$ref": "#/$defs/absolutePath" },
        "max_codex_concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
        "codex_default_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_./:][A-Za-z0-9_.:/-]{0,127}$"
        },
        "codex_default_reasoning_effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "baokuan_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://(?:localhost|127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?(?:/[^#]*)?)$"
        },
        "baokuan_mcp_executable": { "$ref": "#/$defs/optionalAbsolutePath" },
        "obsidian_vault": { "$ref": "#/$defs/optionalAbsolutePath" },
        "topic_cards_dir": { "$ref": "#/$defs/optionalAbsolutePath" },
        "grok_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "grok_model": { "type": "string", "maxLength": 256 },
        "remix_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "remix_model": { "type": "string", "maxLength": 256 },
        "remix_reasoning_effort": {
          "type": "string",
          "enum": ["", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "remix_check_model": { "type": "string", "maxLength": 256 },
        "copy_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "model_options": { "type": "string", "maxLength": 4096 },
        "image_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "image_model": {
          "type": "string",
          "maxLength": 128,
          "default": "gpt-image-2"
        },
        "image_text_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "image_text_model": { "type": "string", "maxLength": 128 },
        "image_text_reasoning_effort": {
          "type": "string",
          "enum": ["", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "image_stream": { "type": "boolean", "default": false },
        "max_image_concurrency": { "type": "integer", "minimum": 1, "maximum": 18, "default": 3 },
        "image_generation_attempts": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
        "default_image_ratio": { "type": "string", "enum": ["3:4", "4:3", "9:16", "1:1"], "default": "3:4" },
        "default_image_style": {
          "type": "string",
          "enum": ["finance_documentary", "red_ink", "old_newspaper", "ledger_investigation", "dark_crisis", "city_era", "blackboard"],
          "default": "finance_documentary"
        },
        "codex_binary_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "media_index_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "media_root": { "$ref": "#/$defs/optionalAbsolutePath" },
        "jianying_root": { "$ref": "#/$defs/optionalAbsolutePath" },
        "machine_profile_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "app_server_enabled": { "type": "boolean" },
        "codex_workspace_roots": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/absolutePath" }
        },
        "codex_task_project_root": { "$ref": "#/$defs/optionalAbsolutePath" },
        "volc_speech_speaker_id": { "type": "string", "maxLength": 256 },
        "volc_speech_resource_id": { "type": "string", "maxLength": 256 },
        "tts_provider": { "type": "string", "enum": ["", "aurastd", "volc"], "default": "aurastd" },
        "aurastd_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$",
          "default": "https://tts.aurastd.com"
        },
        "aurastd_model": { "type": "string", "maxLength": 128, "default": "speech-2.8-hd" },
        "aurastd_voice_id": { "type": "string", "maxLength": 256, "default": "moss_audio_6b1797c8-2329-11f1-8c29-36c83b29da67" },
        "aurastd_speed": { "type": "number", "minimum": 0.5, "maximum": 2, "default": 1.21 },
        "aurastd_volume": { "type": "number", "minimum": 0, "maximum": 10, "default": 1.4 },
        "aurastd_pitch": { "type": "integer", "minimum": -12, "maximum": 12, "default": 1 },
        "aurastd_emotion": { "type": "string", "maxLength": 32 },
        "aurastd_language_boost": { "type": "string", "maxLength": 64, "default": "Chinese" },
        "aurastd_modify_pitch": { "type": "integer", "minimum": -100, "maximum": 100, "default": 0 },
        "aurastd_modify_intensity": { "type": "integer", "minimum": -100, "maximum": 100, "default": 5 },
        "aurastd_modify_timbre": { "type": "integer", "minimum": -100, "maximum": 100, "default": 6 },
        "aurastd_sound_effects": {
          "type": "string",
          "enum": ["", "spacious_echo", "auditorium_echo", "lofi_telephone", "robotic"]
        },
        "media_catalog_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "ffmpeg_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "ffprobe_path": { "$ref": "#/$defs/optionalAbsolutePath" },
        "vision_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "vision_model": { "type": "string", "maxLength": 128 },
        "embedding_base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://[^/#\\s]+(?:/[^#]*)?)$"
        },
        "embedding_model": { "type": "string", "maxLength": 128 },
        "pexels_api_base_url": {
          "type": "string",
          "maxLength": 2048,
          "default": "https://api.pexels.com",
          "pattern": "^(?:$|https://api\\.pexels\\.com(?:/[^#?]*)?)$"
        },
        "pixabay_api_base_url": {
          "type": "string",
          "maxLength": 2048,
          "default": "https://pixabay.com",
          "pattern": "^(?:$|https://pixabay\\.com(?:/[^#?]*)?)$"
        },
        "max_external_results_per_query": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
        "bgm_dir": { "type": "string", "maxLength": 1024 },
        "montage_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caption_size": { "type": "number", "minimum": 5, "maximum": 60 },
            "caption_color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
            "caption_position": { "type": "string", "enum": ["middle", "bottom", "custom"] },
            "caption_y": { "type": "number", "minimum": -1, "maximum": 1 },
            "caption_font": { "type": "string", "maxLength": 64 },
            "plain_size": { "type": "number", "minimum": 5, "maximum": 60 },
            "keyword_size": { "type": "number", "minimum": 5, "maximum": 60 },
            "keyword_color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
            "title_hidden": { "type": "boolean" },
            "title_size": { "type": "number", "minimum": 5, "maximum": 60 },
            "title_color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
            "title_y": { "type": "number", "minimum": -1, "maximum": 1 },
            "subtitle_hidden": { "type": "boolean" },
            "subtitle_size": { "type": "number", "minimum": 5, "maximum": 60 },
            "subtitle_color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
            "subtitle_y": { "type": "number", "minimum": -1, "maximum": 1 },
            "bgm_id": { "type": "string", "maxLength": 128 },
            "bgm_volume": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "publicSettingsUpdate": {
      "allOf": [
        { "$ref": "#/$defs/publicSettings" },
        {
          "required": [
            "listen_addr",
            "data_root",
            "max_codex_concurrency",
            "codex_default_model",
            "codex_default_reasoning_effort",
            "baokuan_base_url",
            "baokuan_mcp_executable",
            "obsidian_vault",
            "topic_cards_dir",
            "grok_base_url",
            "grok_model",
            "codex_binary_path",
            "media_index_path",
            "media_root",
            "jianying_root",
            "machine_profile_path",
            "app_server_enabled",
            "codex_workspace_roots",
            "codex_task_project_root",
            "volc_speech_speaker_id",
            "volc_speech_resource_id"
          ]
        }
      ]
    },
    "publicSettingsView": {
      "allOf": [
        { "$ref": "#/$defs/publicSettings" },
        {
          "required": [
            "listen_addr",
            "data_root",
            "max_codex_concurrency",
            "codex_default_model",
            "codex_default_reasoning_effort",
            "baokuan_base_url",
            "baokuan_mcp_executable",
            "obsidian_vault",
            "topic_cards_dir",
            "grok_base_url",
            "grok_model",
            "remix_base_url",
            "remix_model",
            "remix_reasoning_effort",
            "remix_check_model",
            "copy_base_url",
            "model_options",
            "image_base_url",
            "image_model",
            "image_text_base_url",
            "image_text_model",
            "image_text_reasoning_effort",
            "image_stream",
            "max_image_concurrency",
            "image_generation_attempts",
            "default_image_ratio",
            "default_image_style",
            "codex_binary_path",
            "media_index_path",
            "media_root",
            "jianying_root",
            "machine_profile_path",
            "app_server_enabled",
            "codex_workspace_roots",
            "codex_task_project_root",
            "volc_speech_speaker_id",
            "volc_speech_resource_id",
            "tts_provider",
            "aurastd_base_url",
            "aurastd_model",
            "aurastd_voice_id",
            "aurastd_speed",
            "aurastd_volume",
            "aurastd_pitch",
            "aurastd_emotion",
            "aurastd_language_boost",
            "aurastd_modify_pitch",
            "aurastd_modify_intensity",
            "aurastd_modify_timbre",
            "aurastd_sound_effects",
            "media_catalog_path",
            "ffmpeg_path",
            "ffprobe_path",
            "vision_base_url",
            "vision_model",
            "embedding_base_url",
            "embedding_model",
            "pexels_api_base_url",
            "pixabay_api_base_url",
            "max_external_results_per_query",
            "bgm_dir",
            "montage_style"
          ]
        }
      ]
    },
    "secretInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grok_api_key": { "type": "string", "maxLength": 16384 },
        "remix_api_key": { "type": "string", "maxLength": 16384 },
        "copy_api_key": { "type": "string", "maxLength": 16384 },
        "pexels_api_key": { "type": "string", "maxLength": 16384 },
        "volc_speech_api_key": { "type": "string", "maxLength": 16384 },
        "aurastd_tts_api_key": { "type": "string", "maxLength": 16384 },
        "image_api_key": { "type": "string", "maxLength": 16384 },
        "image_text_api_key": { "type": "string", "maxLength": 16384 },
        "vision_api_key": { "type": "string", "maxLength": 16384 },
        "embedding_api_key": { "type": "string", "maxLength": 16384 },
        "pixabay_api_key": { "type": "string", "maxLength": 16384 }
      }
    },
    "secretStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "masked"],
      "properties": {
        "configured": { "type": "boolean" },
        "masked": { "type": "string" }
      },
      "if": {
        "properties": { "configured": { "const": true } },
        "required": ["configured"]
      },
      "then": {
        "properties": { "masked": { "type": "string", "minLength": 1, "pattern": "^\\*+$" } }
      },
      "else": {
        "properties": { "masked": { "const": "" } }
      }
    },
    "secretView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grok_api_key", "remix_api_key", "copy_api_key", "pexels_api_key", "volc_speech_api_key", "aurastd_tts_api_key", "image_api_key", "image_text_api_key", "vision_api_key", "embedding_api_key", "pixabay_api_key"],
      "properties": {
        "grok_api_key": { "$ref": "#/$defs/secretStatus" },
        "remix_api_key": { "$ref": "#/$defs/secretStatus" },
        "copy_api_key": { "$ref": "#/$defs/secretStatus" },
        "pexels_api_key": { "$ref": "#/$defs/secretStatus" },
        "volc_speech_api_key": { "$ref": "#/$defs/secretStatus" },
        "aurastd_tts_api_key": { "$ref": "#/$defs/secretStatus" },
        "image_api_key": { "$ref": "#/$defs/secretStatus" },
        "image_text_api_key": { "$ref": "#/$defs/secretStatus" },
        "vision_api_key": { "$ref": "#/$defs/secretStatus" },
        "embedding_api_key": { "$ref": "#/$defs/secretStatus" },
        "pixabay_api_key": { "$ref": "#/$defs/secretStatus" }
      }
    },
    "settingsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "secrets"],
      "properties": {
        "public": { "$ref": "#/$defs/publicSettingsUpdate" },
        "secrets": { "$ref": "#/$defs/secretInput" }
      }
    },
    "settingsView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "settings_version", "secrets"],
      "properties": {
        "public": { "$ref": "#/$defs/publicSettingsView" },
        "settings_version": { "type": "integer", "minimum": 0 },
        "secrets": { "$ref": "#/$defs/secretView" }
      }
    }
  }
}
